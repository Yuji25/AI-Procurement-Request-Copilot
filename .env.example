# Runtime settings only; procurement rules remain in code and procurement_policy.md.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REASONING_EFFORT=low
# Set LLM_REASONING_EFFORT empty for endpoints/models without support.
# Architecture A caps its classification at 256 output tokens and disables retries.
AGENT_MAX_TOOL_CALLS=24

# Service base URL, not the /vendor-risk endpoint.
VENDOR_RISK_API_URL=http://127.0.0.1:8001
# VENDOR_RISK_BASE_URL is still accepted as a legacy fallback.
